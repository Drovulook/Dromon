// Traces et aides visuelles de développement, lues au démarrage du moteur
// (cf. `DebugConfig`). Un champ absent prend sa valeur par défaut ; un champ inconnu
// est une erreur.
(
    log_batch_stats: true, // bilan du re-maillage chaque seconde (cache, coût par LOD)
    log_gpu_usage: true,   // occupation / fragmentation de l'allocateur GPU avec ce bilan
    shadows: true,         // false : ombres ignorées (la passe d'ombre tourne quand même)
    camera_unbounded: false, // true : la caméra peut sortir du disque du monde

    mesh: (
        world_walls: true,        // parois verticales au bord du monde
        world_bottom: true,       // face du dessous des chunks
        transition_color: false,  // cellules de transition Transvoxel en magenta
    ),

    // Lookdev : pas de terrain, un sol plat (damier de 1 unité) pour examiner des
    // assets. Rechargé à chaud ; en sortant, le terrain est recréé, les objets posés
    // retirés et la caméra remise à sa pose de départ (render.ron).
    lookdev: (
        enabled: true,
        ground_size: 200.0, // côté du sol, centré sur l'origine
    ),
)
