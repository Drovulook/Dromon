// Détail du monde, calculé à la demande (cf. `WorldDetailConfig`). Graine et étendue
// sont dans `world_macro.ron`. Le modifier n'invalide pas la carte macro.
// Un champ absent prend sa valeur par défaut ; un champ inconnu est une erreur.
//
// Hauteur : sea_level + profil(d) + w(2 − w) · mountain + (1 − w) · fondu(d) · hills, où d
// (distance à la côte) et w (masque des chaînes) viennent de la carte macro. Les deux
// reliefs sont RELATIFS : base_height + amplitude · fBm, ajoutés au profil côtier.
(
    // Chaînes de montagnes. Budget : profil (~230 au pied) + crêtes ≤ max_height (1600).
    // Garder la hauteur moyenne proche de `mountains.amplitude` (world_macro.ron),
    // que voit le climat.
    mountain: (
        base_height: 0.0,
        amplitude: 1200.0,      // fBm ridged ∈ ~[0, 0.8] → crêtes à ~+950
        frequency: 0.00025,
        octaves: 9,
        lacunarity: 2.15,       // non entière, sinon les octaves s'alignent
        gain: 0.5,              // la renormalisation rend `ridge` neutre en amplitude
        erosion: 0.085,         // creuse les vallées sans tout lisser
        ridge: 0.80,            // arêtes vives → montagne escarpée
        lowland_flatness: 0.9,  // vallées douces, détail réservé à l'altitude
        ridge_altitude: 0.8,    // arêtes vives en altitude, vallées arrondies
        ridge_smoothness: 0.02, // arrondit les arêtes des grandes octaves

        // Carte de massifs : fait varier la hauteur LE LONG des chaînes (w dit où
        // elles sont). Longueur d'onde ~10 000.
        massif_frequency: 0.00010,
        massif_low: -0.95,
        massif_high: -0.55,
        massif_min: 0.65, // 1.0 = désactivé

        // Domain warping : déformations à l'échelle des montagnes.
        warp_frequency: 0.00025,
        warp_amplitude: 500.0, // 0.0 = désactivé
    ),

    // Collines des plaines. Toujours ≥ 0 (base_height = amplitude, fBm ∈ [-1, 1]) :
    // un creux ne doit pas passer sous la mer près des côtes basses.
    hills: (
        base_height: 40.0,
        amplitude: 40.0,        // collines de 0 à ~80 voxels
        frequency: 0.0006,      // λ ~1 700 voxels
        octaves: 5,
        lacunarity: 2.15,
        gain: 0.45,
        erosion: 0.2,
        ridge: 0.0,             // collines rondes
        lowland_flatness: 0.0,
        ridge_altitude: 0.0,
        ridge_smoothness: 0.0,
        massif_min: 1.0,        // pas de carte de massifs en plaine
        warp_amplitude: 0.0,
    ),

    // Les collines s'effacent à la côte, pleines à cette distance (voxels).
    hills_coast_fade: 500.0,
)
